# Xcode
build/
# The vendored Ghostty tree has source directories named `build`; they are
# required inputs, not generated Xcode output.
!runtime/vendor/libghostty-vt/src/build/
!runtime/vendor/libghostty-vt/src/build/**
!runtime/vendor/libghostty-vt/src/apprt/gtk/build/
!runtime/vendor/libghostty-vt/src/apprt/gtk/build/**
xcuserdata/
*.xcuserstate
DerivedData/
*.xcscmblueprint
*.xccheckout
# Local Apple signing choice. Public project files intentionally contain no
# maintainer team ID.
.herden.local.mk

# SPM
.build/
.swiftpm/
# Hosted CI restores SwiftPM checkouts here between runs.
.ci/

# Node (pairing plugin)
plugin/node_modules/

# Push Relay (Cloudflare Worker): local secrets and wrangler state.
# The APNs .p8 is a deploy-time secret and must never land in the repo.
relay/.dev.vars
relay/.wrangler/
relay/node_modules/
*.p8

# Native Herden Host runtime build output.
runtime/target/
runtime/.zig-global-cache/
runtime/.zig-cache/
runtime/vendor/libghostty-vt/.zig-cache/
runtime/vendor/libghostty-vt/zig-out/

# Python (test fixtures under scripts/fixtures)
__pycache__/
*.pyc

# macOS
.DS_Store

# Local-only notes and experiments
.local/

# Local testloop scratch artifacts
.testloop/

# Agent workspace (research reports, scratch)
.claude/
.archive/
.skill-archive/
HANDOFF.md
handoff.txt
