---
import { Image } from 'astro:assets';
import arGlasses from '../assets/screenshots/herden-ar-simulator-transparent.png';
import lensDisplay from '../assets/screenshots/herden-glasses-display.png';
import Layout from '../layouts/Layout.astro';

const description =
  'Current status and developer downloads for the experimental Herden read-only display on Even Realities G2 glasses.';
---

<Layout
  title="Herden for Even G2 — Developer preview"
  description={description}
  socialDescription="A read-only Herden Space list and terminal preview for Even G2. The desktop simulator works; physical hardware support is still being verified."
  canonicalPath="/ar"
>
  <section class="ar-hero" aria-labelledby="ar-heading">
    <div class="copy">
      <a class="back" href="/">← Herden for iPhone</a>
      <p class="kicker"><span aria-hidden="true">●</span> Experimental · Even G2</p>
      <h1 id="ar-heading">Herden for<br /><span>Even G2.</span></h1>
      <p class="intro">
        The current preview shows a read-only list of Spaces and recent terminal
        output. It works in the desktop simulator. Installation and networking
        on physical glasses are not verified yet.
      </p>
      <div class="actions">
        <a class="button" href="/downloads/herden-hud-preview-0.1.0.tar.gz">Download desktop demo</a>
        <a class="text-link" href="#install-heading">Run it locally ↓</a>
      </div>
    </div>

    <figure class="preview">
      <Image
        class="glasses"
        src={arGlasses}
        alt="Even G2 glasses displaying the Herden Space list"
        width={520}
        height={260}
        loading="eager"
      />
      <div class="lens">
        <Image
          src={lensDisplay}
          alt="Actual Herden desktop simulator lens output listing generic Spaces"
          width={576}
          height={288}
          loading="eager"
        />
        <figcaption>Actual simulator output</figcaption>
      </div>
    </figure>
  </section>

  <section class="status" aria-labelledby="status-heading">
    <div class="section-heading">
      <p class="kicker"><span aria-hidden="true">→</span> Current status</p>
      <h2 id="status-heading">What works today.</h2>
    </div>
    <dl class="status-list">
      <div>
        <dt><span class="dot ready" aria-hidden="true"></span>Desktop simulator</dt>
        <dd>Works with an offline demo: select a Space, open its output, scroll, and return to the list.</dd>
      </div>
      <div>
        <dt><span class="dot partial" aria-hidden="true"></span>Public Host</dt>
        <dd>Herden 0.9.8 is live and verified. It does not include the experimental glasses endpoint.</dd>
      </div>
      <div>
        <dt><span class="dot blocked" aria-hidden="true"></span>Physical G2</dt>
        <dd>Package install, iPhone network permissions, background wake and battery use still need hardware tests.</dd>
      </div>
    </dl>
  </section>

  <section class="install" aria-labelledby="install-heading">
    <div class="section-heading">
      <p class="kicker"><span aria-hidden="true">→</span> Run it locally</p>
      <h2 id="install-heading">Open the demo.</h2>
      <p class="note">Requires Node.js 22 or newer. No Host, account or access token is used by demo mode.</p>
    </div>

    <ol class="steps">
      <li>
        <span class="number">01</span>
        <div>
          <strong>Download and start Vite</strong>
          <pre><code>tar -xzf herden-hud-preview-0.1.0.tar.gz
cd herden-hud-preview-0.1.0/glasses/app
npm ci
npm run dev</code></pre>
        </div>
      </li>
      <li>
        <span class="number">02</span>
        <div>
          <strong>Open the glasses simulator</strong>
          <pre><code>npm run sim:demo</code></pre>
          <p>Run this in a second Terminal. Use up/down, click, and double-click in the simulator controls.</p>
        </div>
      </li>
    </ol>

    <div class="developer-package">
      <strong>Testing the package format?</strong>
      <p>
        The <a href="/downloads/herden-hud-preview-0.1.0.ehpk">0.1.0 developer .ehpk</a>
        is available, but it is not a supported glasses install. Its network allow-list is
        intentionally empty until the packaged iPhone permissions are verified on a paired G2.
      </p>
    </div>
  </section>
</Layout>

<style>
  .ar-hero,
  .status,
  .install {
    width: min(1040px, calc(100% - 40px));
    margin-inline: auto;
  }

  .ar-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 48px;
    align-items: center;
    min-height: 560px;
    padding: 48px 0;
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
  }

  .back:hover,
  .text-link:hover { color: var(--herden-primary); }

  .kicker {
    color: var(--herden-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kicker span { color: inherit; }
  .ar-hero .kicker { color: var(--herden-attention); }

  h1 {
    margin-top: 18px;
    font-size: clamp(42px, 5.4vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.06em;
  }

  h1 span { color: var(--herden-primary); }

  .intro {
    max-width: 590px;
    margin-top: 22px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 24px;
  }

  .button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 0 15px;
    border: 1px solid var(--herden-primary);
    border-radius: 7px;
    background: var(--herden-primary);
    color: var(--primary-fill-text);
    font-size: 11px;
    font-weight: 700;
  }

  .button:hover { background: var(--herden-primary-hover); }
  .text-link { color: var(--text-secondary); font-size: 11px; font-weight: 700; }

  .preview {
    position: relative;
    min-height: 390px;
    margin: 0;
  }

  .preview :global(.glasses) {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 0;
    display: block;
    width: 390px;
    height: auto;
  }

  .lens {
    position: absolute;
    z-index: 3;
    right: 50px;
    bottom: 0;
    width: 285px;
    padding: 8px;
    border: 1px solid var(--herden-border-strong);
    border-radius: 8px;
    background: var(--surface-code);
    box-shadow: 0 16px 34px rgba(16, 15, 15, 0.12);
  }

  .lens :global(img) { display: block; width: 100%; height: auto; border-radius: 3px; }

  figcaption {
    padding: 7px 2px 0;
    color: var(--herden-muted);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status,
  .install {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 44px;
    padding: 40px 0;
    border-top: 1px solid var(--border-hairline);
  }

  h2 {
    margin-top: 10px;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .status-list { margin: 0; }
  .status-list > div {
    display: grid;
    grid-template-columns: 185px 1fr;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .status-list > div:first-child { padding-top: 0; }
  .status-list > div:last-child { border-bottom: 0; }
  dt { display: flex; gap: 9px; align-items: baseline; font-size: 11px; font-weight: 700; }
  dd { margin: 0; color: var(--text-secondary); font-size: 11px; line-height: 1.55; }

  .dot { width: 7px; height: 7px; flex: none; border-radius: 50%; }
  .ready { background: var(--herden-success); }
  .partial { background: var(--herden-attention); }
  .blocked { border: 1px solid var(--text-muted); }

  .note {
    margin-top: 14px;
    color: var(--text-secondary);
    font-size: 10px;
    line-height: 1.5;
  }

  .steps {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-hairline);
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .steps li:last-child { border-bottom: 0; }
  .number { color: var(--herden-primary); font-size: 10px; font-weight: 700; }
  .steps strong { font-size: 11px; }
  .steps p { margin-top: 8px; color: var(--text-muted); font-size: 10px; line-height: 1.5; }

  pre {
    margin: 9px 0 0;
    padding: 11px 12px;
    overflow-x: auto;
    border-radius: 6px;
    background: var(--surface-code);
    color: var(--code-foreground);
    font-size: 9px;
    line-height: 1.55;
  }

  code { font-family: inherit; }

  .developer-package {
    grid-column: 2;
    padding: 14px 0 0;
    color: var(--text-secondary);
    font-size: 10px;
    line-height: 1.55;
  }

  .developer-package strong { color: var(--herden-attention-ink); }
  .developer-package p { margin-top: 4px; }
  .developer-package a { color: var(--herden-primary); font-weight: 700; text-decoration: underline; text-underline-offset: 0.18em; }

  @media (max-width: 820px) {
    .ar-hero { grid-template-columns: 1fr; gap: 18px; }
    .preview { width: min(440px, 100%); justify-self: center; }
    .status,
    .install { grid-template-columns: 1fr; gap: 24px; }
    .developer-package { grid-column: auto; }
  }

  @media (max-width: 540px) {
    .ar-hero,
    .status,
    .install { width: min(100% - 28px, 1040px); }
    .ar-hero { min-height: 0; padding: 28px 0 30px; }
    .back { margin-bottom: 22px; }
    h1 { margin-top: 14px; font-size: 40px; }
    .intro { margin-top: 14px; font-size: 12px; }
    .actions { margin-top: 18px; }
    .button { min-height: 40px; padding-inline: 12px; font-size: 10px; }
    .preview { min-height: 310px; }
    .preview :global(.glasses) { right: 4%; width: 88%; }
    .lens { right: 11%; width: 72%; }
    .status,
    .install { padding: 28px 0; }
    h2 { font-size: 25px; }
    .status-list > div { grid-template-columns: 1fr; gap: 6px; padding: 13px 0; }
    pre { white-space: pre; }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview :global(.glasses) { transform: none; }
  }
</style>
