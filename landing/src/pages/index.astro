---
import { Image } from 'astro:assets';
import arGlasses from '../assets/screenshots/herden-ar-simulator-transparent.png';
import spacesScreenshot from '../assets/screenshots/herden-spaces-generic.png';
import terminalScreenshot from '../assets/screenshots/herden-terminal-generic.png';
import Layout from '../layouts/Layout.astro';

const description =
  'See Claude Code, Codex and other coding-agent terminals on your iPhone. Check their status, reply by typing or dictation, and send files from any app.';
---

<Layout title="Herden: Your coding agents on iPhone" description={description} canonicalPath="/">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="pitch">
      <p class="kicker"><span aria-hidden="true">●</span> Persistent agents · Your machines</p>
      <h1 id="hero-heading">All your agents.<br /><span>See who needs you.</span></h1>
      <p class="intro">
        Herden shows Claude Code, Codex and other coding-agent terminals on your
        iPhone. Check their status, reply by typing or dictation, and send files
        from any app.
      </p>
      <div class="actions">
        <a class="button" href="https://testflight.apple.com/join/nSsEZBvv">Get iPhone beta</a>
        <a class="text-link" href="#setup">Pair a Host ↓</a>
      </div>
    </div>

    <figure class="product-shot">
      <div class="screen spaces-screen">
        <span class="screen-label">Agent status</span>
        <Image
          src={spacesScreenshot}
          alt="Herden Spaces selector with privacy-safe sample projects and Agent status"
          width={426}
          height={926}
          densities={[1, 2]}
          loading="eager"
        />
      </div>
      <div class="screen terminal-screen">
        <span class="screen-label">Live terminal</span>
        <Image
          src={terminalScreenshot}
          alt="Herden live coding-agent terminal with privacy-safe sample sessions"
          width={426}
          height={926}
          densities={[1, 2]}
          loading="eager"
        />
      </div>
      <a class="glasses-shot" href="/ar" aria-label="Open the Even G2 preview and current development status">
        <span class="glasses-label">Even G2 preview →</span>
        <Image
          src={arGlasses}
          alt="AR glasses with the real simulator’s green terminal list of generic Herden Spaces"
          width={520}
          height={260}
          loading="eager"
        />
      </a>
    </figure>

    <ul class="capabilities" aria-label="Herden capabilities">
      <li><strong>Pair a Host</strong><span>One QR scan</span></li>
      <li><strong>Reply</strong><span>Type or dictate</span></li>
      <li><strong>Send files</strong><span>From any iOS app</span></li>
      <li class="ar-capability"><a href="/ar"><strong>Even G2 →</strong><span>Status + download</span></a></li>
    </ul>
  </section>

  <section id="setup" class="setup" aria-labelledby="setup-heading">
    <div class="setup-heading">
      <p class="kicker"><span aria-hidden="true">→</span> Set up once</p>
      <h2 id="setup-heading">Pair a Host.</h2>
    </div>

    <div class="tailscale">
      <span class="recommended">Recommended</span>
      <p>Use <a href="https://tailscale.com/download">Tailscale</a> on your iPhone and Host. Herden connects over SSH; you do not need to expose it to the public internet.</p>
    </div>

    <ol class="steps">
      <li>
        <span class="number">01</span>
        <div><strong>Connect</strong><p>Put both devices on the same tailnet.</p></div>
      </li>
      <li>
        <span class="number">02</span>
        <div>
          <strong>Install Herden</strong>
          <pre><code>curl -fsSL https://herden.app/install.sh | sh
export PATH="$HOME/.local/bin:$PATH"</code></pre>
        </div>
      </li>
      <li>
        <span class="number">03</span>
        <div><strong>Pair</strong><p>Run <code>herden pair</code>, then open Hosts → Add Host on your iPhone and scan the code.</p></div>
      </li>
    </ol>
  </section>
</Layout>

<style>
  .hero,
  .setup {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: 34px 48px;
    align-items: center;
    padding: 48px 0 34px;
  }

  .kicker {
    color: var(--herden-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kicker span { color: inherit; }

  h1 {
    max-width: 660px;
    margin-top: 20px;
    font-size: clamp(38px, 4.5vw, 60px);
    line-height: 1.03;
    letter-spacing: -0.055em;
  }

  h1 span { color: var(--herden-primary); }

  .intro {
    max-width: 610px;
    margin-top: 22px;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 25px;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    border: 1px solid var(--herden-primary);
    border-radius: 8px;
    background: var(--herden-primary);
    color: var(--primary-fill-text);
    font-size: 13px;
    font-weight: 700;
  }

  .button:hover,
  .button:focus-visible {
    border-color: var(--herden-primary-hover);
    background: var(--herden-primary-hover);
  }

  .text-link {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 700;
  }

  .text-link:hover { color: var(--herden-primary); }

  .product-shot {
    position: relative;
    min-height: 570px;
    margin: 0;
  }

  .screen {
    position: absolute;
    border: 1px solid var(--herden-border);
    border-radius: 29px;
    background: var(--herden-raised);
    box-shadow: 0 18px 42px rgba(16, 15, 15, 0.13);
  }

  .screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 28px;
  }

  .terminal-screen {
    z-index: 3;
    top: 0;
    right: 30px;
    width: 238px;
    transform: rotate(1.25deg);
  }

  .spaces-screen {
    z-index: 2;
    top: 66px;
    left: 20px;
    width: 194px;
    transform: rotate(-2deg);
  }

  .screen-label {
    position: absolute;
    z-index: 3;
    top: 12px;
    padding: 6px 8px;
    border: 1px solid var(--border-hairline);
    border-radius: 999px;
    background: var(--surface-glass);
    color: var(--herden-primary);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .terminal-screen .screen-label { right: -10px; }
  .spaces-screen .screen-label { left: -12px; }

  .glasses-shot {
    position: absolute;
    z-index: 4;
    left: 0;
    bottom: 0;
    width: 260px;
  }

  .glasses-shot:hover :global(img) { transform: translateY(-2px); }

  .glasses-shot:focus-visible {
    border-radius: 12px;
    outline: var(--outline-focus);
    outline-offset: 4px;
  }

  .glasses-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(1.04);
    transition: transform 140ms ease;
  }

  .glasses-label {
    position: absolute;
    right: 12px;
    bottom: 0;
    padding: 5px 7px;
    border: 1px solid var(--border-hairline);
    border-radius: 999px;
    background: var(--surface-glass);
    color: var(--herden-primary);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .capabilities {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-hairline);
    list-style: none;
  }

  .capabilities li {
    display: grid;
    gap: 3px;
    padding: 15px 18px;
    border-right: 1px solid var(--border-hairline);
  }

  .capabilities li:last-child { border-right: 0; }
  .capabilities strong { color: var(--herden-primary); font-size: 12px; }
  .capabilities span { color: var(--text-muted); font-size: 10px; }

  .ar-capability { padding: 0 !important; }
  .ar-capability a {
    display: grid;
    gap: 3px;
    padding: 15px 18px;
  }

  .ar-capability a:hover { background: var(--herden-primary-soft); }

  .setup {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 24px 52px;
    padding: 36px 0 44px;
    border-top: 1px solid var(--border-hairline);
  }

  h2 {
    margin-top: 10px;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .tailscale {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 15px;
    border: 1px solid var(--herden-attention);
    border-left: 4px solid var(--herden-attention);
    border-radius: 8px;
    background: var(--herden-attention-soft);
  }

  .recommended {
    flex: none;
    color: var(--herden-attention-ink);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tailscale p {
    color: var(--text-secondary);
    font-size: 11px;
    line-height: 1.45;
  }

  .tailscale a {
    color: var(--herden-attention-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .steps {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: 0.8fr 1.4fr 1fr;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--border-hairline);
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 8px;
    padding: 16px 14px;
    border-right: 1px solid var(--border-hairline);
  }

  .steps li:last-child { border-right: 0; }
  .steps li > div { min-width: 0; }
  .number { color: var(--herden-primary); font-size: 10px; font-weight: 700; }
  .steps strong { font-size: 12px; }
  .steps p { margin-top: 4px; color: var(--text-muted); font-size: 10px; line-height: 1.45; }

  pre {
    margin: 7px 0 0;
    padding: 9px 10px;
    overflow-x: auto;
    border-radius: 6px;
    background: var(--surface-code);
    color: var(--code-foreground);
    font-size: 10px;
    line-height: 1.45;
  }

  code { font-family: inherit; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 24px; }
    .pitch { max-width: 680px; }
    .product-shot { width: min(500px, 100%); justify-self: center; }
    .capabilities { grid-column: auto; }
    .setup { grid-template-columns: 1fr; gap: 16px; }
    .steps { grid-column: auto; }
  }

  @media (max-width: 540px) {
    .hero,
    .setup { width: min(100% - 28px, 1120px); }

    .hero { padding: 28px 0 22px; }
    h1 { margin-top: 14px; font-size: clamp(31px, 9.2vw, 38px); line-height: 1.06; }
    .intro { margin-top: 14px; font-size: 13px; line-height: 1.48; }
    .actions { margin-top: 18px; }
    .button { min-height: 40px; padding-inline: 13px; font-size: 11px; }
    .text-link { font-size: 10px; }

    .product-shot { min-height: min(500px, 130vw); }
    .screen,
    .screen :global(img) { border-radius: 21px; }
    .terminal-screen { right: 3%; width: 58%; transform: rotate(1.25deg); }
    .spaces-screen { top: 12%; left: 2%; width: 47%; }
    .glasses-shot { left: 0; bottom: 0; width: 58%; }
    .glasses-label { right: 10px; bottom: 0; font-size: 5px; }
    .screen-label { top: 8px; padding: 5px 6px; font-size: 6px; }
    .capabilities { grid-template-columns: repeat(2, 1fr); }
    .capabilities li { padding: 10px 11px; }
    .ar-capability a { padding: 10px 11px; }
    .capabilities li:nth-child(2) { border-right: 0; }
    .capabilities li:nth-child(-n + 2) { border-bottom: 1px solid var(--border-hairline); }

    .setup { padding: 24px 0 28px; }
    h2 { font-size: 24px; }
    .tailscale { align-items: flex-start; padding: 10px 11px; }
    .steps { grid-template-columns: 1fr; }
    .steps li { padding: 10px 8px; border-right: 0; border-bottom: 1px solid var(--border-hairline); }
    .steps li:last-child { border-bottom: 0; }
    pre {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-screen,
    .spaces-screen { transform: none; }
  }
</style>
