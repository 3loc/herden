---
import { Image, Picture } from 'astro:assets';
import logo from '../assets/logo.png';
import agentShot from '../assets/screens/agent-iphone.png';
import Layout from '../layouts/Layout.astro';

const description =
  'Keep coding agents running on your machines. Share screenshots and documents, dictate on your iPhone, and pair over SSH with a QR code.';
---

<Layout title="Herden | Persistent coding agents on your iPhone" description={description}>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Persistent agents. Your machines. Your network.</p>
      <h1>Leave the desk.<br />Keep the session.</h1>
      <p class="intro">
        Herden keeps Claude Code, Codex, and other coding agents running on a
        computer you control. The native iPhone app shows their real terminals
        and lets you answer when they need you. Share a screenshot, attach a
        document, or dictate your next instruction right on your iPhone.
      </p>
      <div class="actions">
        <a class="button primary" href="#install">Install the Host</a>
        <a class="button" href="https://testflight.apple.com/join/nSsEZBvv">Get the iPhone beta</a>
      </div>
      <p class="provenance">
        Herden combines the persistent <a href="https://github.com/herdrdev/herdr">herdr</a>{' '}
        runtime with a native iOS console derived from{' '}
        <a href="https://github.com/ZingerLittleBee/Heeler">Heeler</a>.
        It is open source under Apache-2.0.
      </p>
    </div>

    <div class="product-shot">
      <div class="phone-shadow" aria-hidden="true"></div>
      <Picture
        src={agentShot}
        alt="Herden's Agent terminal on iPhone with Documents, Media, Paste, dictation and terminal keyboard controls"
        formats={['avif', 'webp']}
        widths={[300, 600]}
        sizes="(max-width: 760px) 250px, 300px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section id="features" class="features" aria-labelledby="features-heading">
    <div class="section-heading">
      <p class="kicker">Keep the work moving</p>
      <h2 id="features-heading">Give your Agent the whole picture.</h2>
      <p>
        A screenshot of the bug. A document with the requirements. An idea you
        want to say out loud. Bring it straight into the session you're already
        working in.
      </p>
    </div>
    <ul class="feature-list">
      <li>
        <h3>From another app to your Agent.</h3>
        <p>
          Open the iOS share sheet, choose Herden, and pick your Agent. Send a
          screenshot, photo, video, or document from apps that support file
          sharing. Herden uploads it to the Agent's Host, ready for you to add
          instructions.
        </p>
      </li>
      <li>
        <h3>Attach what words can't show.</h3>
        <p>
          Add screenshots, media, and documents right in Herden. Show the broken
          layout, bring in a reference image, or hand over a brief without
          going back to your desk.
        </p>
      </li>
      <li>
        <h3>Say it while it's fresh.</h3>
        <p>
          Dictate your next instruction instead of typing it. Speech is
          transcribed on your iPhone, so your voice stays on device. Review
          the words and send when you're ready.
        </p>
      </li>
    </ul>
  </section>

  <section id="install" class="setup">
    <div class="section-heading">
      <p class="kicker">Set up once</p>
      <h2>Your machines. One scan away.</h2>
      <p>
        Add any Linux or macOS machine on your tailnet: install the Herden Host,
        show its QR code, and scan it with your iPhone. Connect both devices with{' '}
        <a href="https://tailscale.com/">Tailscale</a> or{' '}
        <a href="https://headscale.net/">Headscale</a> and allow SSH between them.
        Your desktop, laptop, or remote VM is ready to join you wherever you are,
        without opening SSH to the public internet.
      </p>
    </div>

    <ol class="steps">
      <li>
        <span class="step-number">1</span>
        <div>
          <h3>Install and open Herden</h3>
          <p>Run this on the Linux or macOS computer that runs your agents.</p>
          <pre><code>curl -fsSL https://herden.3loc.ltd/install.sh | sh
export PATH="$HOME/.local/bin:$PATH"
herden</code></pre>
        </div>
      </li>
      <li>
        <span class="step-number">2</span>
        <div>
          <h3>Show the Pairing Code</h3>
          <p>
            Already inside Herden? Press <kbd>Ctrl-B</kbd>, then <kbd>i</kbd>.
            From a normal shell, run <code>herden pair</code> instead.
          </p>
        </div>
      </li>
      <li>
        <span class="step-number">3</span>
        <div>
          <h3>Scan with the app</h3>
          <p>
            On the iPhone, open <strong>Herden → Hosts → Add Host</strong> and
            scan the code. Confirm the Host fingerprint when asked.
          </p>
        </div>
      </li>
    </ol>

    <aside class="pair-ticket" aria-label="How to open the Herden Pairing Code">
      <div class="ticket-head">
        <span>HERDEN / PAIR</span>
        <span>ONE DEVICE</span>
      </div>
      <div class="ticket-body">
        <Image src={logo} alt="" width={58} height={58} densities={[2]} loading="eager" />
        <div class="shortcut">
          <span>inside Herden</span>
          <strong><kbd>Ctrl-B</kbd><kbd>i</kbd></strong>
        </div>
        <div class="or">or</div>
        <code>herden pair</code>
      </div>
      <div class="ticket-foot">The code expires after two minutes and enrols one iPhone.</div>
    </aside>
  </section>

  <section class="closing">
    <p class="kicker">No Herden account</p>
    <h2>Your work stays on your computer.</h2>
    <p>
      Prompts, terminal output, files, and credentials travel directly between
      the iPhone and your Host over SSH. Herden has no central application backend.
    </p>
    <a class="text-link" href="https://github.com/3loc/herden">Read the source and build the iOS app →</a>
  </section>
</Layout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 78% 8%, rgba(90, 120, 255, 0.14), transparent 30rem),
      #0b0d13;
  }

  a {
    color: inherit;
    text-decoration-color: #7184ff;
    text-underline-offset: 0.2em;
  }

  .hero,
  .features,
  .setup,
  .closing {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .hero {
    min-height: 720px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: center;
    gap: 96px;
    padding: 104px 0 96px;
  }

  .kicker {
    color: #9aa9ff;
    font: 600 12px/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin-top: 22px;
    font: 600 clamp(48px, 7.2vw, 88px)/0.96 var(--font-sans);
    letter-spacing: -0.055em;
  }

  .intro {
    max-width: 650px;
    margin-top: 32px;
    color: #b8becb;
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid #353b49;
    border-radius: 10px;
    color: #f6f7fb;
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover,
  .button:focus-visible {
    border-color: #7184ff;
  }

  .button.primary {
    border-color: #7184ff;
    background: #7184ff;
    color: #090b11;
  }

  .provenance {
    max-width: 650px;
    margin-top: 28px;
    color: #747d8d;
    font-size: 13px;
    line-height: 1.6;
  }

  .product-shot {
    position: relative;
    justify-self: center;
  }

  .product-shot :global(img) {
    position: relative;
    width: 300px;
    height: auto;
    border: 8px solid #eef1f8;
    border-radius: 44px;
  }

  .phone-shadow {
    position: absolute;
    inset: 12% -12% -8%;
    border-radius: 50%;
    background: #405cff;
    filter: blur(70px);
    opacity: 0.22;
  }

  .setup {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 72px;
    padding: 104px 0;
    border-top: 1px solid #242936;
  }

  .features {
    padding: 104px 0;
    border-top: 1px solid #242936;
  }

  .feature-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-list li {
    padding-top: 24px;
    border-top: 1px solid #242936;
  }

  .section-heading {
    grid-column: 1 / -1;
    max-width: 760px;
  }

  h2 {
    margin-top: 16px;
    font: 600 clamp(34px, 5vw, 58px)/1.04 var(--font-sans);
    letter-spacing: -0.04em;
  }

  .section-heading > p:last-child,
  .closing > p:not(.kicker) {
    max-width: 680px;
    margin-top: 24px;
    color: #aab1bf;
    font-size: 18px;
    line-height: 1.6;
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 18px;
    padding: 26px 0;
    border-top: 1px solid #242936;
  }

  .steps li:last-child {
    border-bottom: 1px solid #242936;
  }

  .step-number {
    color: #9aa9ff;
    font: 600 13px/1.8 var(--font-mono);
  }

  h3 {
    font-size: 20px;
    line-height: 1.3;
  }

  .steps p,
  .feature-list p {
    margin-top: 8px;
    color: #969eae;
    line-height: 1.55;
  }

  pre {
    margin-top: 16px;
    padding: 16px 18px;
    overflow-x: auto;
    border: 1px solid #2e3441;
    border-radius: 8px;
    background: #05070b;
    color: #dce2ee;
    font: 13px/1.75 var(--font-mono);
  }

  code,
  kbd {
    font-family: var(--font-mono);
  }

  kbd {
    display: inline-block;
    padding: 0.12em 0.45em;
    border: 1px solid #4a5262;
    border-bottom-width: 2px;
    border-radius: 5px;
    background: #171b24;
    color: #eef1f8;
    font-size: 0.88em;
  }

  .pair-ticket {
    align-self: center;
    overflow: hidden;
    border: 1px solid #97a5ff;
    border-radius: 14px;
    background: #e9edff;
    color: #0c1020;
    box-shadow: 18px 18px 0 #151a29;
    transform: rotate(1.2deg);
  }

  .ticket-head,
  .ticket-foot {
    display: flex;
    justify-content: space-between;
    padding: 13px 16px;
    font: 700 10px/1.3 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .ticket-head {
    border-bottom: 1px dashed #8995d5;
  }

  .ticket-body {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: 34px 24px;
  }

  .ticket-body :global(img) {
    border-radius: 12px;
  }

  .shortcut {
    display: grid;
    justify-items: center;
    gap: 8px;
  }

  .shortcut span,
  .or {
    font: 600 11px/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.56;
  }

  .shortcut strong {
    display: flex;
    gap: 7px;
  }

  .pair-ticket kbd {
    padding: 9px 12px;
    border-color: #11172b;
    background: #11172b;
    color: #f6f7ff;
    font-size: 17px;
  }

  .ticket-body > code {
    font-size: 19px;
    font-weight: 700;
  }

  .ticket-foot {
    display: block;
    border-top: 1px dashed #8995d5;
    text-align: center;
    letter-spacing: 0;
    text-transform: none;
  }

  .closing {
    padding: 104px 0 120px;
    border-top: 1px solid #242936;
  }

  .closing h2 {
    max-width: 720px;
  }

  .text-link {
    display: inline-block;
    margin-top: 28px;
    color: #c6ceff;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 64px;
      padding-top: 72px;
    }

    .product-shot {
      justify-self: start;
    }

    .product-shot :global(img) {
      width: 250px;
    }

    .setup {
      grid-template-columns: 1fr;
      gap: 54px;
    }

    .feature-list {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 520px) {
    .hero,
    .features,
    .setup,
    .closing {
      width: min(100% - 32px, 1120px);
    }

    .hero {
      min-height: 0;
    }

    .actions {
      display: grid;
    }

    .pair-ticket {
      box-shadow: 10px 10px 0 #151a29;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pair-ticket {
      transform: none;
    }
  }
</style>
