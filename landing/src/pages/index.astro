---
import Connect from '../components/Connect.astro';
import Build from '../components/Build.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import Hero from '../components/Hero.astro';
import Security from '../components/Security.astro';
import Layout from '../layouts/Layout.astro';

const description =
  'Herden keeps coding agents running on your machines and puts every live terminal in one native iOS console over SSH.';
---

<Layout title="Herden — your coding agents, in your pocket" description={description}>
  <Hero />
  <Features />
  <Connect />
  <Build />
  <Security />
  <Faq />
  <Cta />
</Layout>
