---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  updated?: string;
  canonicalPath: string;
}

const { title, description, eyebrow, heading, updated, canonicalPath } = Astro.props;
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <article class="info-page">
    <header class="info-heading">
      <a class="back" href="/">← Herden</a>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {updated && <p class="updated">Last updated {updated}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  .info-page {
    width: min(760px, calc(100% - 40px));
    margin-inline: auto;
    padding: 56px 0 88px;
  }

  .info-heading {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--herden-border);
  }

  .info-heading .back {
    display: inline-block;
    margin-bottom: 36px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;
  }

  .info-heading .back:hover { color: var(--herden-primary); }

  .info-heading .eyebrow {
    color: var(--herden-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .info-heading h1 {
    margin-top: 16px;
    font-size: clamp(36px, 7vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.055em;
  }

  .info-heading .updated {
    margin-top: 18px;
    color: var(--text-muted);
    font-size: 11px;
  }

  .prose { padding-top: 14px; }

  .prose h2 {
    margin-top: 42px;
    font-size: clamp(20px, 3.5vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .prose h3 {
    margin-top: 30px;
    font-size: 15px;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .prose p,
  .prose li,
  .prose td,
  .prose th {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.7;
  }

  .prose p { margin-top: 16px; }

  .prose ul,
  .prose ol {
    margin: 16px 0 0 20px;
  }

  .prose li + li { margin-top: 9px; }

  .prose strong { color: var(--text-primary); }

  .prose a {
    color: var(--herden-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose pre {
    margin-top: 18px;
    padding: 18px;
    overflow-x: auto;
    border-radius: 9px;
    background: var(--surface-code);
    color: var(--code-foreground);
    font-size: 12px;
    line-height: 1.7;
  }

  .prose :not(pre) > code {
    padding: 2px 5px;
    border: 1px solid var(--herden-border);
    border-radius: 4px;
    background: var(--herden-surface);
    color: var(--text-primary);
    font-size: 0.92em;
  }

  .prose table {
    width: 100%;
    margin-top: 18px;
    border-collapse: collapse;
  }

  .prose th,
  .prose td {
    padding: 12px 10px;
    border-top: 1px solid var(--herden-border);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    color: var(--text-primary);
    font-size: 11px;
  }

  .prose .callout {
    margin-top: 24px;
    padding: 16px 18px;
    border-left: 3px solid var(--herden-primary);
    background: var(--herden-primary-soft);
  }

  .prose .callout p:first-child { margin-top: 0; }

  @media (max-width: 640px) {
    .info-page { padding-top: 36px; }
    .info-heading .back { margin-bottom: 28px; }
    .prose table { display: block; overflow-x: auto; }
  }
</style>
