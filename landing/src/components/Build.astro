---
const hostCommands = [
  '<span class="tk-fn">curl</span> -fsSL https://herden.app/install.sh | sh',
].join('\n');

const pairCommands = [
  '<span class="tk-fn">exec</span> "$SHELL" -l',
  '<span class="tk-fn">herden</span> pair',
].join('\n');
---

<section id="build" class="section substrate-grid">
  <div class="container">
    <div class="eyebrow">Get started</div>
    <h2 class="section-title">Install on your Host.</h2>
    <p class="section-lede">Paste this command on Linux or macOS. The installer adds Herden to your Bash or Zsh PATH permanently. Refresh the current Terminal, then pair the TestFlight app.</p>

    <div class="cards">
      <article class="code">
        <div class="card-bar">
          <span class="eyebrow">Install and pair</span>
          <span class="card-lang">bash</span>
        </div>
        <pre set:html={hostCommands}></pre>
      </article>

      <article class="code">
        <div class="card-bar">
          <span class="eyebrow">Start and pair</span>
          <span class="card-lang">bash</span>
        </div>
        <pre set:html={pairCommands}></pre>
      </article>
    </div>

    <p class="detail">The <a class="text-link" href="/install-host">complete Host guide</a> covers SSH, Tailscale, pairing, and common setup failures.</p>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6);
    margin-top: var(--sp-10);
  }

  .code {
    min-width: 0;
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-card);
    background: var(--surface-code);
    overflow: hidden;
  }

  .card-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    padding: 0 var(--sp-4);
    border-bottom: 1px solid var(--border-hairline);
  }

  .card-lang {
    font: var(--type-mono-sm);
    letter-spacing: var(--tr-mono);
    color: var(--text-muted);
  }

  pre {
    margin: 0;
    padding: var(--sp-5);
    font: var(--type-mono);
    letter-spacing: var(--tr-mono);
    color: var(--syn-plain);
    overflow-x: auto;
  }

  .detail {
    max-width: 760px;
    margin-top: var(--sp-6);
    font: var(--type-body-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
