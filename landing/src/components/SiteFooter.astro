---
import { Image } from 'astro:assets';
import logoDark from '../assets/logo-dark.svg';
import logoLight from '../assets/logo-light.svg';

const links = [
  { href: '/install-host', label: 'Host guide' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/licenses', label: 'Licences + attribution' },
];
---

<footer class="footer">
  <div class="container layout">
    <div class="brand">
      <Image class="mark mark-light" src={logoLight} alt="" width={18} height={18} densities={[2, 3]} loading="eager" />
      <Image class="mark mark-dark" src={logoDark} alt="" width={18} height={18} densities={[2, 3]} loading="eager" />
      <span class="tagline">Self-hosted coding agents on iPhone.</span>
    </div>
    <div class="links">
      {links.map((link) => <a class="link" href={link.href}>{link.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 22px 0 28px;
  }

  .layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-8);
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-2-5);
  }

  .mark { flex: none; }
  .mark-dark { display: none; }

  .tagline,
  .link {
    font: var(--type-body-sm);
    color: var(--text-secondary);
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  .link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .layout { gap: 12px; }
    .links { gap: 14px; }
    .tagline,
    .link { font-size: 10px; }
  }

  :global(html[data-theme="dark"]) .mark-light { display: none; }
  :global(html[data-theme="dark"]) .mark-dark { display: block; }
</style>
